{
  "expo": {
    "name": "MeuPrimeiroApp",
    "slug": "MeuPrimeiroApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o MeuPrimeiroApp acesse a câmera para registrar fotos.",
          "microphonePermission": "Permitir que o MeuPrimeiroApp acesse o microfone para gravar áudio.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que o MeuPrimeiroApp acesse o microfone para gravar áudio."
        }
      ]
    ]
  }
}
